{
  "permissions": {
    "allow": [
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git ls-tree *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(aipmc *)",
      "Bash(sqlite3 *)",
      "Bash(conda run *)",
      "Bash(PYTHONIOENCODING=utf-8 conda run *)",
      "Bash(xargs grep -l \"pmai\\\\|aipm\")",
      "Bash(curl *)",
      "Bash(cp *)",
      "Bash(echo *)",
      "Bash(cat)",
      "WebSearch",
      "mcp__aipm__aipm_get_briefing",
      "mcp__aipm__aipm_search_context",
      "Bash(python3 -m json.tool)"
    ]
  },
  "enabledMcpjsonServers": [
    "aipm"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aipmc",
            "args": [
              "hook-process"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aipmc",
            "args": [
              "hook-process"
            ]
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aipmc",
            "args": [
              "hook-process"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aipmc",
            "args": [
              "hook-process"
            ]
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "aipm": {
      "command": "aipmc",
      "args": [
        "mcp"
      ]
    }
  }
}
